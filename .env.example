# LLM provider: anthropic | openai | fake
IELTS_LLM_PROVIDER=anthropic
IELTS_LLM_MODEL=claude-opus-5-5
# IELTS_LLM_EFFORT=medium
# For OpenAI-compatible local servers (Ollama / vLLM):
# IELTS_LLM_PROVIDER=openai
# IELTS_LLM_MODEL=qwen2.5:14b
# IELTS_LLM_BASE_URL=http://localhost:11434/v1

# Embeddings: sentence-transformers (semantic) | hashing (surface words only, no download)
IELTS_EMBEDDER=sentence-transformers
IELTS_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Query expansion glossary: data/<exam>/glossary.yaml
IELTS_USE_GLOSSARY=true
